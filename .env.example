# Copy to .env (gitignored), fill in, then `chmod 600 .env`. Never commit .env.
# Single-quote any value that might contain a literal "$" so Compose doesn't
# try to interpolate it.

# --- Veza tenant: used by both the HRIS push and (documented) Insight Point ---
VEZA_URL="https://your-tenant.vezacloud.com"
VEZA_API_KEY="<sandbox-api-key>"
# Comma-separated hostnames the HRIS integration may run against. Should
# generally match VEZA_URL's host — it's an independent safety check, not
# derived automatically, by design (see hris/modules/lcm_test_hris_hooks.py).
VEZA_URL_ALLOWLIST="your-tenant.vezacloud.com"

# --- Veza Insight Point (registers this lab's openldap as a data source) ---
DP_REGISTER_KEY="<insight-point-register-key>"

# --- OpenLDAP target: tree structure comes from ldap/tree.yaml, base DN/domain from here ---
LDAP_ADMIN_PASSWORD="<choose-a-password>"
LDAP_BASE_DN="dc=example,dc=org"
LDAP_DOMAIN="example.org"
LDAP_ORGANISATION="Example Organization"

# --- HRIS mock scenario ---
# baseline | joiner | mover | leaver | rehire | convert (see hris/README.md)
LCM_SCENARIO="baseline"
